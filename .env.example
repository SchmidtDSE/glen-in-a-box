# Copy to .env and edit. `make bundle` reads this too.

# ── Where the browser reaches the stack ──────────────────────────────────────
# This string is baked into the STAC catalog hrefs at seed time and taught to
# the MCP server's href→s3:// rewriter. Change it and you must re-run
# `make seed`, or the catalog will advertise URLs the browser cannot resolve.
#
# For a LAN demo use the host's address, e.g. http://192.168.1.42:8080 —
# NOT localhost, which would only resolve on the machine running Docker.
PUBLIC_ORIGIN=http://localhost:8080
PUBLIC_PORT=8080

# Which host interface the published port binds to. 0.0.0.0 (the default) is
# right for a laptop. Behind a reverse proxy that enforces authentication, set
# this to the address the proxy reaches this box on — otherwise the proxy asks
# for a password and a direct hit on http://<host>:8080 does not.
PUBLIC_BIND=0.0.0.0

# ── Pinned versions ──────────────────────────────────────────────────────────
# GEO_AGENT_REF is snapshotted into the webapp image at build time. Bump it
# deliberately: app/vendor/patch-geoagent.mjs asserts every external URL it
# expects to find, so a version that moved them fails the build loudly rather
# than shipping a half-offline app.
GEO_AGENT_REF=v3.25.0

# Pin a real release. The MCP image's `latest` tag has published as an
# image with an empty /app that exits immediately on start, taking the SQL and
# STAC backend down with no error in the log.
MCP_TAG=v0.8.1
TAG=local

# ── Local LLM ────────────────────────────────────────────────────────────────
# The file must exist in ./llm/models — fetch it once with `make model`.
LLM_MODEL_FILE=Qwen3-8B-Q4_K_M.gguf
LLM_MODEL_ID=qwen3-8b
# QUOTE any value containing spaces or shell metacharacters. This file is read
# two different ways: docker compose parses it itself (tolerant of bare spaces),
# but scripts/preflight.sh, scripts/verify.sh and the Makefile `. ./.env` it as
# shell. An unquoted `Qwen3 8B (local)` is a shell syntax error, and sourcing
# stops there — so every variable BELOW this line silently ends up unset, which
# looks like anything except a quoting problem.
LLM_MODEL_LABEL="Qwen3 8B (local)"
# 32k costs ~2 GB of KV cache at q8_0. Drop to 16384 on a 16 GB machine.
LLM_CTX=32768
LLM_THREADS=8

# Guards the /api/llm/ route. Leave as "local" on a laptop — the route is then
# open, which is fine when nothing else can reach it.
#
# Set a real secret for any box reachable from elsewhere. This is the ONLY thing
# that can protect the LLM route: an authenticating reverse proxy cannot, because
# the app overwrites the Authorization header with this value on every request,
# so a proxy doing basic auth 401s and the browser re-prompts forever. Exempt
# /api/llm/ at the proxy and keep config.json (which carries this token to the
# browser) behind the proxy's auth.
LLM_API_KEY=local

# GPU only (make up-gpu). Which card to use, and how many layers to offload —
# 99 means all; an 8B Q4_K_M needs about 6 GB of VRAM. Check what is idle first:
#   nvidia-smi --query-gpu=index,memory.used,memory.total --format=csv
GPU_DEVICE_ID=0
LLM_GPU_LAYERS=99

# ── Data source ──────────────────────────────────────────────────────────────
# `make data` mirrors already-processed census layers from this STAC catalog, so
# no Census API key is needed anywhere in this project. Point it at your own
# mirror to build the bundle without reaching the public bucket.
# CENSUS_SOURCE_BASE=https://s3-west.nrp-nautilus.io/public-census

# ── Object store ─────────────────────────────────────────────────────────────
# Only ever reachable on the internal compose network, but change it anyway if
# the box will sit on a shared LAN.
S3_ACCESS_KEY=glenadmin
S3_SECRET_KEY=glenadmin-change-me

# ── Laptop-scale tuning ──────────────────────────────────────────────────────
TILE_BUILD_THREADS=4
TILE_THREADS=4
MCP_QUERY_CONCURRENCY=2
DUCKDB_MEMORY_LIMIT=2GB
