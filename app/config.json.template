{
    "_comment": [
        "Deploy-time config, rendered from this template at container start.",
        "",
        "mcp_server_url MUST be absolute. Everything else browser-facing in this",
        "deployment is a root-relative path, deliberately, so it follows whatever",
        "origin the page loaded from — but the MCP client does `new URL(url)`",
        "with no base, and `new URL('/mcp')` THROWS. The transport never gets",
        "constructed, the error is swallowed, and the agent reports that the MCP",
        "server is unreachable while the server is perfectly healthy and every",
        "server-side probe passes. So this one is built from PUBLIC_ORIGIN at",
        "container start, which is why that value must match the address bar.",
        "Contains no secrets and needs none: the LLM is a local container with",
        "no authentication, reached through the same-origin /api/llm/ proxy.",
        "api_key is what the OpenAI client puts in its Authorization header.",
        "llama.cpp ignores it, but nginx does not: set LLM_API_KEY to a real",
        "secret and the /api/llm/ route requires it. That is how the LLM is",
        "protected when the box is not on a laptop, because an authenticating",
        "reverse proxy cannot protect that route — the app overwrites the",
        "Authorization header with this value on every request."
    ],

    "mcp_server_url": "${PUBLIC_ORIGIN}/mcp",

    "llm_model": "${LLM_MODEL_ID}",
    "llm_models": [
        {
            "value": "${LLM_MODEL_ID}",
            "label": "${LLM_MODEL_LABEL}",
            "endpoint": "/api/llm",
            "api_key": "${LLM_API_KEY}"
        }
    ]
}
