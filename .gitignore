# Local configuration
.env

# ── Build artifacts ──────────────────────────────────────────────────────────
# All large, all reproducible with `make bundle`, none belong in git.
# `make clean` deliberately leaves them alone — they take hours to rebuild.

# Census bundle and its download cache (~1-2 GB + cache)
data/bundle/
data/cache/

# LLM weights (~5 GB)
llm/models/

# Basemap extract, glyphs, sprites (~1-2 GB) and the go-pmtiles binary
basemap/data/
basemap/bin/

# Generated by basemap/build.sh from protomaps-themes-base. config.json itself
# IS committed; only the generated styles are not.
basemap/config/styles/

# Air-gap archives (~10-15 GB)
airgap/

# ── Incidentals ──────────────────────────────────────────────────────────────
*.part
__pycache__/
*.pyc
.DS_Store
